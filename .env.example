# Find an apprenticeship vacancy service. Required: the app will not start without it.
APPRENTICESHIP_API_KEY=your-apprenticeship-key-here

# Language model (Gemini). Optional: leave this line commented out to run without it.
# Get a key from Google AI Studio, then remove the # and paste it in.
# GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# LangSmith tracing. Optional. Set to true and add a key from smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=apprenticeship-navigator-dev

# Local database started by `docker compose up -d`.
# Change the password here and in DATABASE_URL to the same new value.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/postgres