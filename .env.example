# Language model (Gemini). Get a key from Google AI Studio.
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# LangSmith tracing. Get a key from smith.langchain.com.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=apprenticeship-navigator-dev